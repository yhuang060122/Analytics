{
  "compilerOptions": {
    "target": "es2022",
    "module": "commonjs",
    "moduleResolution": "node10",
    "ignoreDeprecations": "6.0",
    "lib": ["ES2023", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "rootDir": "../analytics",
    "outDir": "./.build"
  },
  "include": [
    "../analytics/index.ts",
    "../analytics/core/api/analytics.ts",
    "../analytics/adapters/browser/auto-track.ts",
    "../analytics/adapters/index.ts",
    "../analytics/adapters/jquery/index.ts",
    "../analytics/adapters/angular/index.ts"
  ]
}
