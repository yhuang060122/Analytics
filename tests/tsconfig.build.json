{
  "compilerOptions": {
    "target": "es2022",
    "module": "commonjs",
    "moduleResolution": "node10",
    "ignoreDeprecations": "6.0",
    "lib": ["ES2023", "DOM"],
    "strict": true,
    "skipLibCheck": true,

    /* Bans constructor parameter properties, enums and
       namespaces — none of which the bundler can erase.
       `verbatimModuleSyntax` cannot go here: the SDK is built
       to CommonJS, and ESM syntax in a CJS file is TS1295.
       Type-only imports are guarded by architecture.test.mjs
       instead ("types are imported with import type"). */
    "erasableSyntaxOnly": true,
    "rootDir": "../analytics",
    "outDir": "./.build"
  },
  "include": [
    "../analytics/index.ts",
    "../analytics/core/api/analytics.ts",
    "../analytics/adapters/browser/auto-track.ts",
    "../analytics/adapters/index.ts",
    "../analytics/adapters/jquery/index.ts",
    "../analytics/adapters/angular/index.ts"
  ]
}
